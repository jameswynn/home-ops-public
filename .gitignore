/tmp/*
kubeconfig
.decrypted~*
old/
todo.md

# doco-cd bootstrap env (real secrets live on the VPS only; commit .env.example instead)
docker/vps/.doco-cd/.env

# Claude Code git worktrees. These are full checkouts of other branches, so
# gitleaks rescans every file in them under a different path — which misses the
# path-keyed fingerprints in .gitleaksignore and fails the pre-commit hook on
# already-accepted findings.
.claude/worktrees/

# mise local overrides. mise.local.toml merges over the committed mise.toml and
# wins on conflicts. Not needed for the BWS credentials — those are SOPS-encrypted
# in tofu/mikrotik/env.sops.yaml — but ignored so a stray one can never be
# committed with secrets in it.
mise.local.toml
.mise.local.toml
mise.*.local.toml
.mise.*.local.toml

# RouterOS config exports and backups. `/export` output contains credentials in
# clear text (gitleaks flags them) and `/system backup` is a binary image of the
# whole device. Both are working files for tofu/mikrotik/BOOTSTRAP.md — never
# commit them.
*.rsc
*.backup

# OpenTofu (tofu/). State and plan files hold provider credentials in plaintext,
# so ignore them by extension rather than by name — the branch that introduced
# this ignored `terraform.tfstate` while the module actually wrote `tofu.tfstate`.
tofu/**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
crash.log
crash.*.log
