{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Authentik image and chart",
      "groupName": "authentik",
      "matchPackagePatterns": ["goauthentik", "authentik"],
      "matchDatasources": ["docker", "github-releases", "helm"],
      "matchUpdateTypes": ["minor", "patch"],
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      },
      "separateMinorPatch": false
    },
    {
      "description": "cert-manager image and chart",
      "groupName": "cert-manager",
      "matchPackagePatterns": ["cert-manager"],
      "matchDatasources": ["docker", "github-releases", "helm"],
      "matchUpdateTypes": ["minor", "patch"],
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      },
      "separateMinorPatch": false
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/", "/flux-operator-manifests/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 3,
    },
    {
      description: "Intel Device Plugins Group",
      groupName: "intel-device-plugins",
      matchDatasources: ["docker", "github-releases", "helm"],
      matchPackageNames: ["/intel-device-plugins-operator/", "/intel-device-plugins-gpu/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      // Two pins for one binary: the mise tool in //mise.toml and the kritika
      // runner tool in //.kritika.yaml. They must move together so local and PR
      // reviews render with the same flate version.
      // The mise pin stores a bare version; .kritika.yaml requires the full
      // v-prefixed release tag, handled by the rule below.
      description: "flate CLI: mise pin + Kritika pin",
      groupName: "flate",
      matchDatasources: ["github-releases"],
      matchPackageNames: ["home-operations/flate"],
      extractVersion: "^v(?<version>.+)$",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      // kritika requires the exact v-prefixed release tag for aqua tools, unlike
      // the bare-version mise pin. Later rules win, so this re-extracts the full
      // tag for .kritika.yaml only; the groupName above still applies.
      description: "flate in .kritika.yaml: keep the v-prefixed tag",
      matchFileNames: [".kritika.yaml"],
      matchDatasources: ["github-releases"],
      matchPackageNames: ["home-operations/flate"],
      extractVersion: "^(?<version>v.+)$",
    },
  ]
}
