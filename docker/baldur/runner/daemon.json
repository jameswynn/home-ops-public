{
  "builder": {
    "gc": {
      "enabled": true,
      "defaultReservedSpace": "2GB",
      "policy": [
        { "keepDuration": "48h", "maxUsedSpace": "1GB", "filter": ["type=source.local"] },
        { "keepDuration": "168h", "reservedSpace": "2GB", "maxUsedSpace": "10GB" },
        { "reservedSpace": "2GB", "maxUsedSpace": "10GB", "all": true }
      ]
    }
  }
}
